FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY merge.js server.js ./

ENV DATA_DIR=/app/data
EXPOSE 8787

CMD ["node", "server.js"]
